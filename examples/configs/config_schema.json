{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenPenny Configuration",
  "type": "object",
  "required": [],
  "additionalProperties": false,
  "definitions": {
    "include_file": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "object",
          "required": ["path"],
          "additionalProperties": false,
          "properties": {
            "path": { "type": "string" },
            "section": { "type": "string" }
          }
        }
      ]
    }
  },
  "properties": {
    "log": {
      "type": "object",
      "required": ["mode", "level"],
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["console", "file"] },
        "level": { "type": "string", "enum": ["trace", "debug", "info", "warn", "error"] }
      }
    },

    "includes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "log": { "$ref": "#/definitions/include_file" },
        "traffic_policy": { "$ref": "#/definitions/include_file" },
        "runtime_policy": { "$ref": "#/definitions/include_file" },
        "platform": { "$ref": "#/definitions/include_file" },
        "grpc": { "$ref": "#/definitions/include_file" },
        "egress": { "$ref": "#/definitions/include_file" }
      }
    },

    "traffic_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "type": "string", "enum": ["include", "exclude"] },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "name": { "type": "string" },
              "label": { "type": "string" },
              "priority": { "type": "integer" },
              "decision": { "type": "string", "enum": ["include", "exclude"] },
              "src_prefix": { "type": "string", "description": "Source IPv4 CIDR prefix; bare IP means /32." },
              "dst_prefix": { "type": "string", "description": "Destination IPv4 CIDR prefix; bare IP means /32." },
              "protocol": {
                "oneOf": [
                  { "type": "integer", "minimum": 0, "maximum": 255 },
                  { "type": "string", "enum": ["tcp", "udp", "icmp"] }
                ]
              },
              "src_port": { "type": "integer", "minimum": 0, "maximum": 65535 },
              "dst_port": { "type": "integer", "minimum": 0, "maximum": 65535 }
            }
          }
        }
      }
    },

    "runtime_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "enum": ["active", "passive"] },
        "allow_ssh_bypass": { "type": "boolean" },
        "aggregates_enabled": { "type": "boolean" },
        "aggregates": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean" }
          }
        },
        "safety": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allow_ssh_bypass": { "type": "boolean" }
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "packet_drop_probability": { "type": "number", "minimum": 0, "maximum": 1 },
            "max_duplicate_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "max_reordering_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "retransmission_observation_miss_rate": { "type": "number", "minimum": 0, "maximum": 1 },
            "retransmission_timeout_in_seconds": { "type": "number", "exclusiveMinimum": 0 },
            "admission_grace_period_seconds": { "type": "number", "minimum": 0 },
            "monitored_flow_idle_expiry_seconds": { "type": "number", "minimum": 0 },
            "drop_state_seconds": { "type": "number", "minimum": 0 },
            "min_packet_drops_per_flow": { "type": "integer", "minimum": 0 },
            "max_packet_drops_per_flow": { "type": "integer", "minimum": 0 },
            "max_packet_drops_global_aggregate": { "type": "integer", "minimum": 0 },
            "max_monitored_flows": { "type": "integer", "minimum": 0 },
            "stop_after_individual_flows": { "type": "integer", "minimum": 0 },
            "min_closed_loop_flows": { "type": "integer", "minimum": 0 },
            "passive_min_flows_to_finish": { "type": "integer", "minimum": 0 },
            "passive_max_parallel_flows": { "type": "integer", "minimum": 0 },
            "passive_max_execution_time_seconds": { "type": "number", "minimum": 0 }
          }
        }
      }
    },

    "platform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": { "type": "string", "enum": ["af_xdp", "af_packet_mirror", "dpdk"] },
        "ingress_mode": { "type": "string", "enum": ["auto", "copy", "redirect"] },
        "interface": { "type": "string" },
        "ifname": { "type": "string" },
        "queue": { "type": "integer", "minimum": 0 },
        "queue_count": { "type": "integer", "minimum": 1 },
        "worker_cpus": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 }
        },
        "batch": { "type": "integer", "minimum": 1 },
        "poll_timeout_ms": { "type": "integer", "minimum": 0 },
        "af_xdp": { "$ref": "#/properties/platform/properties/xdp" },
        "xdp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interface": { "type": "string" },
            "ifname": { "type": "string" },
            "queue": { "type": "integer", "minimum": 0 },
            "rx_queue": { "type": "integer", "minimum": 0 },
            "queue_count": { "type": "integer", "minimum": 1 },
            "worker_cpus": {
              "type": "array",
              "items": { "type": "integer", "minimum": 0 }
            },
            "drv_mode": { "type": "boolean" },
            "zerocopy": { "type": "boolean" },
            "require_zerocopy": { "type": "boolean" },
            "allow_skb_fallback": { "type": "boolean" },
            "allow_copy_fallback": { "type": "boolean" },
            "force_copy_mode": { "type": "boolean" },
            "attach_program": { "type": "boolean" },
            "detach_on_close": { "type": "boolean" },
            "pin_maps": { "type": "boolean" },
            "reuse_pins": { "type": "boolean" },
            "update_dataplane_rules": { "type": "boolean" },
            "frame_size": { "type": "integer", "minimum": 512 },
            "num_frames": { "type": "integer", "minimum": 1024 },
            "rx_ring": { "type": "integer", "minimum": 64 },
            "batch": { "type": "integer", "minimum": 1 },
            "poll_timeout_ms": { "type": "integer", "minimum": 0 },
            "bpf_object": { "type": "string" },
            "bpf_program": { "type": "string" }
          }
        },
        "dpdk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "interface": { "type": "string" },
            "ifname": { "type": "string" },
            "device": { "type": "string" },
            "queue": { "type": "integer", "minimum": 0 },
            "burst": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },

    "grpc": {
      "type": "object",
      "required": ["enable", "listen_ip", "listen_port"],
      "additionalProperties": false,
      "properties": {
        "enable": { "type": "boolean" },
        "listen_ip": { "type": "string", "format": "ipv4" },
        "listen_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enable": { "type": "boolean" },
            "cert_file": { "type": "string" },
            "key_file": { "type": "string" }
          }
        }
      }
    },

    "egress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["none", "tun", "raw_socket", "raw_nic"]
        },
        "device":    { "type": "string" },
        "interface": { "type": "string" },
        "ifname":    { "type": "string" },
        "tun": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "multi_queue": { "type": "boolean" },
            "mtu":         { "type": "integer", "minimum": 0 },
            "txqlen":      { "type": "integer", "minimum": 0 },
            "bring_up":    { "type": "boolean" }
          }
        },
        "raw_nic": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bind_device": { "type": "boolean" }
          }
        }
      }
    }
  }
}
